# Profilo client OpenVPN (esempio): le chiavi reali NON sono pubblicate.
client
dev tun
proto udp
remote <IP_PUBBLICO_FIREWALL> 1194
resolv-retry infinite
nobind
remote-cert-tls server
auth-user-pass            # utente e password LDAP
data-ciphers AES-256-GCM:AES-128-GCM
verb 3
<ca>
<CERTIFICATO_CA>
</ca>
<cert>
<CERTIFICATO_CLIENT  (CN = nome utente LDAP)>
</cert>
<key>
<CHIAVE_PRIVATA_CLIENT>
</key>
<tls-crypt>
<CHIAVE_TLS_CRYPT>
</tls-crypt>
